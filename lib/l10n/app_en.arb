    "description": "FAQ — answer about what Citizen Space is."
  },
  "faqQuestion2": "What do I need to access my Citizen Space?",
  "@faqQuestion2": {
    "description": "FAQ — question about access requirements."
  },
  "faqAnswer2": "You need to identify yourself with Cl@ve, an electronic certificate, or the enabled access system. You can use Cl@ve Móvil, Cl@ve Permanente, electronic ID, or an electronic certificate.",
  "@faqAnswer2": {
    "description": "FAQ — answer about access requirements."
  },
  "faqQuestion3": "What personal data is stored?",
  "@faqQuestion3": {
    "description": "FAQ — question about stored personal data."
  },
