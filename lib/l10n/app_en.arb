  "privacyPurposeTitle": "What is the name and purpose of the processing?",
  "privacyPopulationControllerText": "2. The Castilla-La Mancha Data Office is the controller for Population Register data. Its contact address is C/ Cabriel, 12 – Edificio CIE III, 45071 Toledo, and its email address is oficinadeldato@jccm.es.",
  "@privacyPopulationControllerText": {"description": "Privacy page — Population Register controller and contact."},
  "@privacyPurposeTitle": {
    "description": "Privacy page — heading of the processing purpose section."
  },
  "privacyPurposeIntro": "The purposes of the processing of personal data carried out directly within the Espacio Ciudadano processing activity are the following:",
  "@privacyPurposeIntro": {
    "description": "Privacy page — introductory paragraph of the processing purposes."
  },
  "privacyPurposeItemIdentity": "Management of Espacio Ciudadano as a tool for citizens to interact with the Regional Administration and its autonomous bodies:\n\n• Managing citizens' contact details for electronic-notification alerts.\n• Managing information on ongoing proceedings, their status and notifications.\n• Displaying selected education, health, social welfare, employment, housing and vehicle data.\n• Managing authorizations and consent.\n• Managing recommendations based exclusively on selected life events and creating a profile for this purpose.\n• Displaying agenda events.",
  "@privacyPurposeItemIdentity": {
    "description": "Privacy page — bullet item in the list of purposes."
  },
  "privacyPurposeItemVisualizations": "The purposes of Population Register processing are:\n\n• Producing official statistics.\n• Communication between JCCM bodies and citizens.\n• Evaluating the quality of services provided.",
  "@privacyPurposeItemVisualizations": {
    "description": "Privacy page — bullet item in the list of purposes."
  },
  "privacyLegalBasisTitle": "What is the legal basis for this processing?",
  "@privacyLegalBasisTitle": {"description": "Privacy page — legal basis title."},
  "privacyLegalBasisText": "The legal bases for Espacio Ciudadano processing are legal obligation and performance of a task carried out in the public interest (Article 6.1(c) and (e) GDPR), including Law 39/2015, Royal Decree 203/2021 and Law 4/2025. Processing of State Administration information, recommendations, events and selected cards is based on consent, which may be withdrawn in the user profile.\n\nFor the Population Register, telephone and email processing is based on consent (Article 6.1(a)); other data is processed in the public interest (Article 6.1(e), Law 10/2002 on Castilla-La Mancha Statistics).",
  "@privacyLegalBasisText": {"description": "Privacy page — legal bases."},
  "privacyTransfersTitle": "Are data transferred?",
  "@privacyTransfersTitle": {"description": "Privacy page — transfers title."},
  "privacyTransfersText": "Personal data is not transferred as part of Espacio Ciudadano processing.\n\nPopulation Register data may be transferred to other regional Administration bodies for communication with citizens, after assessing purpose compatibility under Article 6.4 GDPR.",
  "@privacyTransfersText": {"description": "Privacy page — information about transfers."},
  "privacyRetentionTitle": "How long will the data be retained?",
  "@privacyRetentionTitle": {"description": "Privacy page — retention title."},
  "privacyRetentionText": "Data will be retained for as long as necessary to fulfil the purpose for which it was collected and to determine any liabilities arising from that purpose and processing. Archives and documentation rules will apply.",
  "@privacyRetentionText": {"description": "Privacy page — retention period."},
  "privacyRightsTitle": "How can data-protection rights be exercised?",
  "@privacyRightsTitle": {"description": "Privacy page — exercising rights title."},
  "privacyRightsText": "You may exercise your rights of access, rectification, erasure, restriction, objection and not to be subject to automated decisions free of charge, either in writing through a Registry Office addressed to the controller, or online at https://www.jccm.es/tramites/1001969.",
  "@privacyRightsText": {"description": "Privacy page — ways to exercise rights."},
  "privacyAepdTitle": "Can I lodge a complaint with the Spanish Data Protection Agency?",
  "@privacyAepdTitle": {
    "description": "Privacy page — heading of the section on complaints to the AEPD."
  },
  "privacyAepdTextBeforeLink": "If you have evidence or indications proving that your right to data protection has been infringed in Espacio Ciudadano or in the Population Register, you may lodge a complaint with the Agencia Española de Protección de Datos (Spanish Data Protection Agency), ",
  "@privacyAepdTextBeforeLink": {
    "description": "Privacy page — AEPD section text before the link to its website (ends with a comma and a space)."
  },
  "privacyAepdLinkLabel": "Spanish Data Protection Agency (AEPD)",
  "@privacyAepdLinkLabel": {"description": "Privacy page — AEPD link text."},
  "privacyAepdTextAfterLink": ". You may also lodge a complaint with the data protection officer, whose contact details are included in this information.",
  "@privacyAepdTextAfterLink": {
