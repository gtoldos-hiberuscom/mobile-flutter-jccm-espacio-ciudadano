{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/scripts/pre_tool_branch_policy.py",
        "cwd": ".",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "python3 .github/hooks/scripts/pre_tool_architecture_policy.py",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/scripts/post_tool_architecture_validate.py",
        "cwd": ".",
        "timeoutSec": 20
      }
    ]
  }
}
