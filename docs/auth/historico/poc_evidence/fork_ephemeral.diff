+  /**
+   * Reports whether the browser AppAuth would select for the next authorization
+   * flow supports ephemeral Custom Tabs, plus diagnostic details. Never includes
+   * secrets or request data.
+   */
+  private Map<String, Object> getEphemeralBrowsingAvailability() {
+    createAuthorizationServices();
+    BrowserDescriptor browser = defaultAuthorizationService.getBrowserDescriptor();
+    Map<String, Object> availability = new HashMap<>();
+    if (browser == null) {
+      availability.put("browserPackage", null);
+      availability.put("browserVersion", null);
+      availability.put("usesCustomTab", false);
+      availability.put("ephemeralBrowsingSupported", false);
+      return availability;
+    }
+    boolean supported =
+        browser.useCustomTab
+            && CustomTabsClient.isEphemeralBrowsingSupported(
+                applicationContext, browser.packageName);
+    availability.put("browserPackage", browser.packageName);
+    availability.put("browserVersion", browser.version);
+    availability.put("usesCustomTab", browser.useCustomTab);
+    availability.put("ephemeralBrowsingSupported", supported);
+    return availability;
+  }
+
+  /**
+   * Builds a CustomTabsIntent with ephemeral browsing enabled when the Dart side
+   * requested an ephemeral external user agent. Returns null when no ephemeral
+   * session was requested (callers then use AppAuth's default intent). When
+   * ephemeral was requested but the selected browser cannot guarantee it, this
+   * finishes the pending operation with an error and throws to abort the launch:
+   * silently falling back would reintroduce shared browser cookies, which is
+   * exactly what the caller asked to avoid.
+   */
+  @Nullable
+  private CustomTabsIntent createEphemeralCustomTabsIntentIfRequested(
+      AuthorizationService authorizationService, Uri requestUri)
+      throws EphemeralBrowsingUnavailableException {
+    if (externalUserAgent == null || externalUserAgent != EPHEMERAL_EXTERNAL_USER_AGENT) {
+      return null;
+    }
+
+    BrowserDescriptor browser = authorizationService.getBrowserDescriptor();
+    boolean usesCustomTab = browser != null && browser.useCustomTab;
+    boolean supported =
+        usesCustomTab
+            && CustomTabsClient.isEphemeralBrowsingSupported(
+                applicationContext, browser.packageName);
+
+    Log.d(
+        POC_LOG_TAG,
+        String.format(
+            "ephemeralRequested=true browserPackage=%s browserVersion=%s usesCustomTab=%s"
+                + " ephemeralSupported=%s",
+            browser == null ? "none" : browser.packageName,
+            browser == null ? "none" : browser.version,
+            usesCustomTab,
+            supported));
+
+    if (!supported) {
+      finishWithError(
+          EPHEMERAL_BROWSING_UNAVAILABLE_ERROR_CODE,
+          String.format(
+              EPHEMERAL_BROWSING_UNAVAILABLE_ERROR_FORMAT,
+              browser == null ? "none" : browser.packageName),
+          null);
+      throw new EphemeralBrowsingUnavailableException();
+    }
+
+    return authorizationService
+        .createCustomTabsIntentBuilder(requestUri)
+        .setEphemeralBrowsingEnabled(true)
+        .build();
+  }
+
+  /** Signals that an ephemeral session was required but cannot be provided. */
